{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "buildCommand": "REACT_APP_API_BASE_URL=https://church-digital-engagement-platform-2q9v.onrender.com/api/v1 REACT_APP_GOOGLE_CLIENT_ID=258988026617-2po3fisocs5sjuevhjste0i1van7a315.apps.googleusercontent.com CI=false npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://church-digital-engagement-platform-2q9v.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/|static/|favicon|manifest|logo|robots|asset-manifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
